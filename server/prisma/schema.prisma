generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Activity {
  id          String   @id @default(uuid())
  householdId String   @map("household_id")
  userId      String?  @map("user_id")
  type        String
  message     String
  metadata    String?  @map("metadata")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  household Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, createdAt(sort: Desc)])
  @@map("activities")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  avatarUrl String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  householdMembers HouseholdMember[]
  adjustments      InventoryAdjustment[]
  notifications    Notification[]
  receiptImports   ReceiptImport[]
  shoppingItems    ShoppingListItem[]
  activities       Activity[]

  @@map("users")
}

model Household {
  id         String   @id @default(uuid())
  name       String
  inviteCode String   @unique @map("invite_code")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  members          HouseholdMember[]
  inventoryItems   InventoryItem[]
  shoppingItems    ShoppingListItem[]
  notifications    Notification[]
  receiptImports   ReceiptImport[]
  activities       Activity[]

  @@map("households")
}

model HouseholdMember {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  householdId String   @map("household_id")
  role        String   @default("MEMBER")
  joinedAt    DateTime @default(now()) @map("joined_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  household  Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
  @@map("household_members")
}

model InventoryItem {
  id                String   @id @default(uuid())
  householdId       String   @map("household_id")
  name              String
  brand             String?
  category          String   @default("OTHER")
  quantity          Float    @default(0)
  unit              String   @default("PIECE")
  location          String   @default("KITCHEN")
  customLocation    String?  @map("custom_location")
  barcode           String?
  imageUrl          String?  @map("image_url")
  minimumThreshold  Float    @default(0) @map("minimum_threshold")
  expiryDate        DateTime? @map("expiry_date")
  isArchived        Boolean  @default(false) @map("is_archived")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  household  Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  adjustments InventoryAdjustment[]
  consumptionRecords ConsumptionRecord[]

  @@map("inventory_items")
}

model InventoryAdjustment {
  id              String   @id @default(uuid())
  inventoryItemId String   @map("inventory_item_id")
  userId          String   @map("user_id")
  type            String   @default("ADD")
  quantity        Float
  previousQuantity Float   @map("previous_quantity")
  newQuantity     Float    @map("new_quantity")
  note            String?
  createdAt       DateTime @default(now()) @map("created_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("inventory_adjustments")
}

model ShoppingListItem {
  id              String   @id @default(uuid())
  householdId     String   @map("household_id")
  name            String
  quantity        Float    @default(1)
  unit            String   @default("PIECE")
  priority        String   @default("MEDIUM")
  status          String   @default("PENDING")
  assignedToUserId String? @map("assigned_to_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  assignedTo User?    @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@map("shopping_list_items")
}

model ConsumptionRecord {
  id                      String   @id @default(uuid())
  inventoryItemId         String   @map("inventory_item_id")
  householdId             String   @map("household_id")
  quantityUsed             Float    @map("quantity_used")
  usageDurationDays       Float    @map("usage_duration_days")
  averageDailyConsumption Float    @map("average_daily_consumption")
  recordedAt              DateTime @default(now()) @map("recorded_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@map("consumption_records")
}

model Notification {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  householdId  String   @map("household_id")
  type         String   @default("LOW_STOCK")
  title        String
  message      String
  isRead       Boolean  @default(false) @map("is_read")
  relatedItemId String? @map("related_item_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model BarcodeProduct {
  id        String   @id @default(uuid())
  barcode   String   @unique
  name      String
  brand     String?
  category  String?
  unit      String?
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("barcode_products")
}

model ReceiptImport {
  id          String   @id @default(uuid())
  householdId String   @map("household_id")
  userId      String   @map("user_id")
  imageUrl    String   @map("image_url")
  ocrText     String?  @map("ocr_text")
  parsedItems String?  @map("parsed_items")
  status      String   @default("PENDING")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("receipt_imports")
}